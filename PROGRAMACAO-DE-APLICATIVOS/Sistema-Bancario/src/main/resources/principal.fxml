<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller.PrincipalController"
      styleClass="root"
      stylesheets="@style.css"
      alignment="CENTER"
      spacing="20"
      prefWidth="420"
      prefHeight="580">

    <Label fx:id="bemVindoLabel" styleClass="titulo"/>
    <Label text="O que deseja fazer?" styleClass="subtitulo"/>

    <VBox styleClass="card" spacing="14">
        <Button text="Depositar" styleClass="botao-primario"
                onAction="#handleDeposito" maxWidth="Infinity"/>
        <Button text="Sacar" styleClass="botao-primario"
                onAction="#handleSaque" maxWidth="Infinity"/>
        <Button text="Consultar Saldo" styleClass="botao-primario"
                onAction="#handleConsulta" maxWidth="Infinity"/>
        <Button text="Ver Extrato" styleClass="botao-primario"
                onAction="#handleExtrato" maxWidth="Infinity"/>
        <Button text="Sair" styleClass="link"
                onAction="#handleSair" maxWidth="Infinity"/>
    </VBox>

</VBox>